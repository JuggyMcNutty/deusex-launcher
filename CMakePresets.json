{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "port",
      "hidden": true,
      "description": "One preset per ports/<id>/; the preset name is the port id.",
      "binaryDir": "${sourceDir}/build/${presetName}/launcher",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DXL_PORT": "${presetName}"
      }
    },
    {
      "name": "linux-x86_64",
      "inherits": "port",
      "displayName": "Linux x86_64 (native; tests and dxl-shots)"
    }
  ],
  "buildPresets": [
    { "name": "linux-x86_64",    "configurePreset": "linux-x86_64" }
  ],
  "testPresets": [
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64",
      "output": { "outputOnFailure": true }
    }
  ]
}
