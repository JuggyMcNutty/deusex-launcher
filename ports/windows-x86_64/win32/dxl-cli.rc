// dxl-cli.exe's resources: its manifest (app.manifest) and its version.
#include <winuser.h>
#include <winver.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Port Ex Machina"
            VALUE "FileDescription", "DXLauncher with no window, for scripts"
            VALUE "InternalName", "dxl-cli"
            VALUE "LegalCopyright", "zlib licence; Deus Ex belongs to its owners"
            VALUE "OriginalFilename", "dxl-cli.exe"
            VALUE "ProductName", "DXLauncher"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
