# Multiplayer: a server that asks for a password, joined: its field first,
# the password typed, Enter (test_ui_scripts.c finds it the engine's, and
# not in the launcher's log).
wait 2
expect home
find Multiplayer
key Return
wait 2.5
expect multiplayer
find Fake One
key Return
wait 0.5
expect multiplayer
type sesame
key Return
