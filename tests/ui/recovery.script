# Recovery after a crash: the log read, the next run on the software
# renderer, another renderer, Play, a crash again, Home, Quit:
# test_ui_scripts.c reads the runs' command lines and the renderer chosen.
wait 1.5
expect home
find Play
key Return
wait 2.5
expect recovery
wait 1.5

find The log
key Return
wait 0.5
expect log
find Back
key Return
wait 0.5
expect recovery

find Software renderer
key Return
find Another renderer...
key Return
wait 0.5
expect pick
key Down
key Return
wait 0.5
expect recovery

find Play
key Return
wait 2.5
expect recovery
find Home
key Return
wait 0.5
expect home
find Quit
key Return
